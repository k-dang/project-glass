{
  "$schema": "https://unpkg.com/knip@6.45.1/schema.json",
  "ignore": [
    ".agents/skills/!(verify-glass)/**",
    ".claude/**",
    "apps/desktop/src/renderer/components/ui/**",
    "apps/desktop/src/renderer/components/message-scroller/**",
    "tools/oxlint/anti-slop/**"
  ],
  "ignoreBinaries": ["netstat"],
  "workspaces": {
    ".": {
      "entry": [
        "examples/fake-sandboxes/{index.ts,claude.mjs}",
        ".agents/skills/verify-glass/scripts/{glass-verify.ts,fail-backend-start.cjs}"
      ]
    },
    "apps/desktop": {
      "entry": ["src/{main,preload,browserPreload}/index.ts", "e2e/background.cjs"],
      "project": ["src/**/*.{ts,tsx,css}", "test/**/*.{ts,tsx}", "e2e/**/*.{ts,cjs}"]
    },
    "apps/server": {
      "entry": [
        "src/{bin,agentHost,sqlReadWorker}.ts",
        "src/agentHost/pi{DrawDiagram,SuggestDraft}.ts",
        "test/{fakeBackend,fakeSandboxProvider,scriptedAgentHost}.ts"
      ],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "apps/gallery": {
      "project": ["**/*.{ts,tsx}"]
    },
    "examples/*": {
      "entry": ["index.ts"]
    },
    "packages/contracts": {
      "entry": ["src/pluginConformance.ts"]
    }
  }
}
