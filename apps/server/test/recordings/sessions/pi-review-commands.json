{
  "scenario": "pi-review-commands",
  "program": "@earendil-works/pi-coding-agent 1.5.2",
  "processes": [
    {
      "args": [
        "--mode",
        "rpc",
        "--no-extensions",
        "--no-mcp",
        "--no-skills",
        "--no-prompt-templates",
        "--no-themes",
        "--no-context-files",
        "--no-approve"
      ],
      "cwd": "<pi-home>",
      "frames": [
        {
          "out": {
            "type": "get_commands",
            "id": "glass-1"
          }
        },
        {
          "in": {
            "id": "glass-1",
            "type": "response",
            "command": "get_commands",
            "success": true,
            "data": {
              "commands": []
            }
          }
        }
      ]
    },
    {
      "args": ["--mode", "rpc"],
      "cwd": "<folder>",
      "frames": [
        {
          "out": {
            "type": "get_commands",
            "id": "glass-1"
          }
        },
        {
          "in": {
            "id": "glass-1",
            "type": "response",
            "command": "get_commands",
            "success": true,
            "data": {
              "commands": [
                {
                  "name": "llama",
                  "description": "Manage llama.cpp router models",
                  "source": "extension",
                  "sourceInfo": {
                    "path": "builtin:llama.cpp",
                    "source": "builtin",
                    "scope": "temporary",
                    "origin": "top-level"
                  }
                },
                {
                  "name": "mcp",
                  "description": "Manage MCP servers: sign in, reconnect, enable or disable, and change exposure",
                  "source": "extension",
                  "sourceInfo": {
                    "path": "builtin:mcp",
                    "source": "builtin",
                    "scope": "temporary",
                    "origin": "top-level"
                  }
                },
                {
                  "name": "skill:greet",
                  "description": "Greets the user by name.",
                  "source": "skill",
                  "sourceInfo": {
                    "path": "<folder>/.pi/skills/greet/SKILL.md",
                    "source": "auto",
                    "scope": "project",
                    "origin": "top-level",
                    "baseDir": "<folder>/.pi"
                  }
                }
              ]
            }
          }
        }
      ]
    }
  ],
  "calls": []
}
